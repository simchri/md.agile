#!/usr/bin/env bash
# The `autogit` command line tool: manages the global/local config files and
# prints status (see doc/development/autogit.md). The actual sync-loop
# daemon logic lives in autogit-daemon, not here.
set -euo pipefail

# Log level helpers, following the loga/logi/logw/loge pattern from
# snippets.bash. Intentionally duplicated (not shared via a lib) between
# autogit and autogit-daemon: it's a handful of lines, and keeping each
# script self-contained avoids needing an install-path lookup for a shared
# file. All levels always write to the log file; only INFO is additionally
# gated behind AUTOGIT_VERBOSE for stderr output. WARNING/ERROR are also
# echoed to stderr (colored), matching snippets.bash's logw/loge.
AUTOGIT_LOG_DIR="${AUTOGIT_LOG_DIR:-/tmp/autogit}"
AUTOGIT_VERBOSE="${AUTOGIT_VERBOSE:-0}"

log_line() { # log_line <component> <level> <message>
  local component="$1" level="$2" message="$3"
  mkdir -p "$AUTOGIT_LOG_DIR"
  local file="$AUTOGIT_LOG_DIR/${component}-$(date +%F).log"
  printf '%s [%s] %-7s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$component" "$level" "$message" >> "$file"
}

loga() { # log "always" (also echoed to stderr unconditionally)
  log_line "$1" "ALWAYS" "$2"
  printf '%s\n' "$2" 1>&2
}

logi() { # log "info" (only echoed to stderr if AUTOGIT_VERBOSE=1)
  log_line "$1" "INFO" "$2"
  if [[ "$AUTOGIT_VERBOSE" == 1 ]]; then
    printf 'INFO    %s\n' "$2" 1>&2
  fi
}

logw() { # log "warning" (always echoed to stderr, colored)
  local YELLOW='\033[0;33m' DEFAULT='\033[0m'
  log_line "$1" "WARNING" "$2"
  printf "${YELLOW}WARNING${DEFAULT} %s\n" "$2" 1>&2
}

loge() { # log "error" (always echoed to stderr, colored)
  local RED='\033[0;31m' DEFAULT='\033[0m'
  log_line "$1" "ERROR" "$2"
  printf "${RED}ERROR${DEFAULT}   %s\n" "$2" 1>&2
}

# run_logged <component> <level: i|w|e> <description> <cmd...>
# Helper for calling external commands: runs <cmd...>, capturing its stdout
# and stderr separately. On success, the captured stdout is forwarded to our
# own stdout (so the helper also works inside `$(...)`) and stderr is
# discarded. On failure, nothing is forwarded; instead, a single log entry
# "<description> (exit <rc>: <cmd...>)" is written at the given level (via
# logi/logw/loge), followed by the last RUN_LOGGED_MAX_LINES lines of each
# non-empty stream as indented continuation lines. Always returns the
# command's exit code, so callers keep full control over the failure path.
# The full failure message (incl. captured output) is also left in
# RUN_LOGGED_LAST_ERROR, e.g. for recording it in the repo's error state.
RUN_LOGGED_MAX_LINES=50
RUN_LOGGED_LAST_ERROR=""

run_logged() {
  local component="$1" level="$2" description="$3"; shift 3
  local out err rc=0 msg
  out="$(mktemp)"
  err="$(mktemp)"
  "$@" > "$out" 2> "$err" || rc=$?
  if [ "$rc" -eq 0 ]; then
    cat "$out"
  else
    msg="$description (exit $rc: $*)"
    msg+="$(format_captured_stream stdout "$out")"
    msg+="$(format_captured_stream stderr "$err")"
    "log$level" "$component" "$msg"
    RUN_LOGGED_LAST_ERROR="$msg"
  fi
  rm -f "$out" "$err"
  return "$rc"
}

format_captured_stream() { # format_captured_stream <name> <file> ; newline-prefixed indented block, empty if the stream was empty
  local name="$1" file="$2" total note=""
  [ -s "$file" ] || return 0
  total="$(awk 'END { print NR }' "$file")"
  if [ "$total" -gt "$RUN_LOGGED_MAX_LINES" ]; then
    note=" (truncated, showing last $RUN_LOGGED_MAX_LINES of $total lines)"
  fi
  printf '\n    %s:%s\n' "$name" "$note"
  tail -n "$RUN_LOGGED_MAX_LINES" "$file" | sed 's/^/      | /'
}

# --- global config (observed repos + global on/off) ---------------------
# Hand-rolled minimal TOML subset (see doc/development/autogit.md
# Architecture): only our own canonical output is guaranteed parseable.
#   enabled = true
#   repos = [
#     "/abs/path/one",
#     "/abs/path/two",
#   ]

global_config_file() {
  printf '%s\n' "${AUTOGIT_GLOBAL_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/mdagile/autogit.toml}"
}

global_read_enabled() {
  local f; f="$(global_config_file)"
  if [ -f "$f" ] && grep -q '^enabled' "$f"; then
    grep -m1 '^enabled' "$f" | sed -E 's/^enabled *= *//'
  else
    echo "true"
  fi
}

global_read_repos() {
  local f; f="$(global_config_file)"
  [ -f "$f" ] || return 0
  sed -n '/^repos = \[/,/^\]/p' "$f" | grep -oE '"[^"]*"' | sed 's/^"//; s/"$//'
}

global_repo_registered() { # global_repo_registered <path>
  global_read_repos | grep -qxF "$1"
}

global_write() { # global_write <enabled> <repo1> <repo2> ...
  local enabled="$1"; shift
  local f; f="$(global_config_file)"
  mkdir -p "$(dirname "$f")"
  {
    printf 'enabled = %s\n' "$enabled"
    if [ "$#" -eq 0 ]; then
      printf 'repos = []\n'
    else
      printf 'repos = [\n'
      for repo in "$@"; do
        printf '  "%s",\n' "$repo"
      done
      printf ']\n'
    fi
  } > "$f"
}

global_add_repo() { # global_add_repo <path>
  local path="$1" enabled
  enabled="$(global_read_enabled)"
  mapfile -t repos < <(global_read_repos)
  if ! printf '%s\n' "${repos[@]:-}" | grep -qxF "$path"; then
    repos+=("$path")
  fi
  global_write "$enabled" "${repos[@]}"
}

global_remove_repo() { # global_remove_repo <path>
  local path="$1" enabled kept=()
  enabled="$(global_read_enabled)"
  mapfile -t repos < <(global_read_repos)
  for r in "${repos[@]:-}"; do
    [ -n "$r" ] && [ "$r" != "$path" ] && kept+=("$r")
  done
  global_write "$enabled" "${kept[@]}"
}

global_set_enabled() { # global_set_enabled <true|false>
  local value="$1"
  mapfile -t repos < <(global_read_repos)
  global_write "$value" "${repos[@]:-}"
}

# --- local config (per-repo options, read by autogit-daemon) -------------
# Whether a repo is synced is decided solely by its registration in the
# global config; there is no per-repo on/off setting.

local_config_file() { # local_config_file [<repo>] ; defaults to the current directory's repo toplevel
  local root="${1:-}"
  [ -n "$root" ] || root="$(git rev-parse --show-toplevel)"
  printf '%s/.autogit.toml\n' "$root"
}

local_config_init_if_missing() { # local_config_init_if_missing [<repo>]
  local f; f="$(local_config_file "${1:-}")"
  [ -f "$f" ] || printf '# autogit local config (see doc/development/autogit.md "Local Configurations")\n' > "$f"
}

# --- systemd status (best-effort, silent if no user systemd session) ----

systemd_warning() {
  command -v systemctl >/dev/null 2>&1 || return 0
  systemctl --user list-units >/dev/null 2>&1 || return 0
  systemctl --user is-active --quiet autogit.service 2>/dev/null && return 0
  echo "  warning: autogit systemd service is not active"
}

# --- abnormal git state detection (Safety Guards) -------------------------
# Duplicated from autogit-daemon (not shared via a lib, per project
# convention): both `autogit status` and the sync loop need to detect the
# same set of "abnormal" git states and skip/warn accordingly.

abnormal_state_reason() { # abnormal_state_reason <repo> ; echoes reason + exit 1 if abnormal, else exit 0
  local repo="$1" gitdir
  gitdir="$(git -C "$repo" rev-parse --absolute-git-dir 2>/dev/null)" || { echo "not a git repository"; return 1; }
  if [ -d "$gitdir/rebase-merge" ] || [ -d "$gitdir/rebase-apply" ]; then
    echo "mid-rebase"; return 1
  fi
  if [ -f "$gitdir/MERGE_HEAD" ]; then
    echo "mid-merge"; return 1
  fi
  if [ -f "$gitdir/CHERRY_PICK_HEAD" ]; then
    echo "mid-cherry-pick"; return 1
  fi
  if [ -f "$gitdir/BISECT_LOG" ]; then
    echo "mid-bisect"; return 1
  fi
  if ! git -C "$repo" rev-parse HEAD >/dev/null 2>&1; then
    echo "unborn branch"; return 1
  fi
  if ! git -C "$repo" symbolic-ref -q HEAD >/dev/null 2>&1; then
    echo "detached HEAD"; return 1
  fi
  if git -C "$repo" submodule status 2>/dev/null | grep -qE '^[+-]'; then
    echo "dirty/uninitialized submodules"; return 1
  fi
  return 0
}

# --- per-repo error state (read-only here) ---------------------------------
# Written by autogit-daemon after each repo's sync cycle; reader duplicated
# here (not shared via a lib, per project convention). File format:
# `key = value` header lines (state/step/since/updated), then, for errors, a
# blank line followed by the full error message incl. captured command output.

AUTOGIT_STATE_DIR="${AUTOGIT_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/autogit}"

repo_state_key() { # repo_state_key <repo> ; must match autogit-daemon's
  printf '%s' "$1" | sha256sum | cut -c1-16
}

repo_status_file() { printf '%s/%s.status\n' "$AUTOGIT_STATE_DIR" "$(repo_state_key "$1")"; }

repo_status_field() { # repo_status_field <repo> <key> ; empty if no state recorded
  local f; f="$(repo_status_file "$1")"
  [ -f "$f" ] || return 0
  sed -n "/^\$/q; s/^$2 = //p" "$f"
}

repo_status_message() { # repo_status_message <repo> ; the error message body (after the blank line)
  local f; f="$(repo_status_file "$1")"
  [ -f "$f" ] || return 0
  sed '1,/^$/d' "$f"
}

format_epoch() { date -d "@$1" '+%Y-%m-%d %H:%M:%S'; }

# --- current-repo helper --------------------------------------------------

require_git_repo() {
  git rev-parse --show-toplevel 2>/dev/null
}

resolve_repo_arg() { # resolve_repo_arg <path> ; resolves <path> (relative or absolute) to its git repo toplevel
  local path="$1" repo
  repo="$(run_logged "cli" e "not a git repository: $path" git -C "$path" rev-parse --show-toplevel)" || { echo "error: not a git repository: $path" 1>&2; exit 1; }
  printf '%s\n' "$repo"
}

# --- subcommands -----------------------------------------------------------

cmd_add() {
  local repo
  repo="$(resolve_repo_arg "${1:?usage: autogit add <path>}")"
  global_add_repo "$repo"
  local_config_init_if_missing "$repo"
  logi "cli" "registered repo: $repo"
  echo "autogit: registered $repo"
}

cmd_remove() {
  local repo lf
  repo="$(resolve_repo_arg "${1:?usage: autogit remove <path>}")"
  global_remove_repo "$repo"
  lf="$(local_config_file "$repo")"
  logi "cli" "unregistered repo: $repo"
  echo "auto-git off for $repo. Config file $lf retained. If you permanently want to un-manage this repo, you can delete this file now."
}

cmd_on() {
  global_set_enabled true
  logi "cli" "autogit turned on globally"
  echo "autogit: on"
}

cmd_off() {
  global_set_enabled false
  logi "cli" "autogit turned off globally"
  echo "autogit: off"
}

cmd_status() { # exits 1 if any observed repo (or the current repo) is in an error state
  local genabled any_error=0
  genabled="$(global_read_enabled)"
  echo "Global status:"
  if [ "$genabled" = "true" ]; then
    echo "  auto-git: on"
  else
    echo "  auto-git: off"
  fi
  systemd_warning
  mapfile -t repos < <(global_read_repos)
  if [ "${#repos[@]}" -eq 0 ]; then
    echo "  observed repos: (none)"
  else
    echo "  observed repos:"
    for r in "${repos[@]}"; do
      if [ "$(repo_status_field "$r" state)" = "error" ]; then
        any_error=1
        echo "    - $r  [ERROR: $(repo_status_field "$r" step)]"
      else
        echo "    - $r"
      fi
    done
  fi

  local repo
  if repo="$(require_git_repo)"; then
    echo ""
    echo "Local status (this repo: $repo):"
    if ! global_repo_registered "$repo"; then
      echo "  not managed by autogit. Run 'autogit add .' to register it."
      [ "$any_error" -eq 0 ] || exit 1
      return 0
    fi
    local reason
    if ! reason="$(abnormal_state_reason "$repo")"; then
      # log file only: the stdout line below is the user-facing message
      log_line "cli" "WARNING" "repo is in an abnormal git state ($reason)"
      echo "  warning: repo is in an abnormal git state ($reason). auto-git will skip this repo until it is resolved."
    fi
    case "$(repo_status_field "$repo" state)" in
      "")
        echo "  last sync: not yet synced"
        ;;
      error)
        any_error=1
        echo "  last sync: ERROR in step '$(repo_status_field "$repo" step)' (failing since $(format_epoch "$(repo_status_field "$repo" since)"), last attempt $(format_epoch "$(repo_status_field "$repo" updated)"))"
        repo_status_message "$repo" | sed 's/^/    /'
        ;;
      *)
        echo "  last sync: $(repo_status_field "$repo" state) ($(format_epoch "$(repo_status_field "$repo" updated)"))"
        ;;
    esac
  fi

  if [ "$any_error" -ne 0 ]; then
    exit 1
  fi
}

print_usage() {
  cat <<'USAGE'
usage: autogit <command> [args]

commands:
  add <path>            register the repo at <path> (relative or absolute; use '.' for the current repo) for auto-git (adds to global config)
  remove <path>         turn auto-git off for the repo at <path> (relative or absolute; use '.' for the current repo) (removes from global config; local config is retained)
  on                    turn auto-git on globally
  off                   turn auto-git off globally
  status                print global + local (this repo) auto-git status
USAGE
}

main() {
  if [ "$#" -eq 0 ]; then
    print_usage
    exit 0
  fi
  local cmd="$1"; shift
  case "$cmd" in
    add) cmd_add "$@" ;;
    remove) cmd_remove "$@" ;;
    on) cmd_on "$@" ;;
    off) cmd_off "$@" ;;
    status) cmd_status "$@" ;;
    -h|--help|help) print_usage ;;
    *)
      log_line "cli" "ERROR" "unknown command: $cmd"
      echo "error: unknown command: $cmd" 1>&2
      print_usage 1>&2
      exit 1
      ;;
  esac
}

main "$@"
