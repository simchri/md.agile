#!/usr/bin/env bash
# The `autogit` command line tool. Scaffolding scope: no useful
# functionality yet — just a placeholder that prints a greeting and logs
# that it was invoked (see doc/development/autogit.md).
set -euo pipefail

# autogit_log <component> <message>
# Intentionally duplicated (not shared via a lib) between autogit and
# autogit-daemon: it's a handful of lines, and keeping each script
# self-contained avoids needing an install-path lookup for a shared file.
AUTOGIT_LOG_DIR="${AUTOGIT_LOG_DIR:-/tmp/autogit}"
autogit_log() {
  local component="$1"
  local message="$2"
  mkdir -p "$AUTOGIT_LOG_DIR"
  local file="$AUTOGIT_LOG_DIR/${component}-$(date +%F).log"
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$component" "$message" >> "$file"
}

echo "hello world"
autogit_log "cli" "autogit invoked: $*"
