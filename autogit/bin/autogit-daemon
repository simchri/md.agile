#!/usr/bin/env bash
# Systemd-managed daemon script. Scaffolding scope: does nothing useful yet,
# just logs a heartbeat once a minute (see doc/development/autogit.md).
set -euo pipefail

# autogit_log <component> <message>
# Intentionally duplicated (not shared via a lib) between autogit and
# autogit-daemon: it's a handful of lines, and keeping each script
# self-contained avoids needing an install-path lookup for a shared file.
AUTOGIT_LOG_DIR="${AUTOGIT_LOG_DIR:-/tmp/autogit}"
autogit_log() {
  local component="$1"
  local message="$2"
  mkdir -p "$AUTOGIT_LOG_DIR"
  local file="$AUTOGIT_LOG_DIR/${component}-$(date +%F).log"
  printf '%s [%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$component" "$message" >> "$file"
}

# `--once`: log a single heartbeat and exit, instead of looping forever.
# Lets tests (and manual smoke-checks) exercise the daemon without waiting.
once=0
if [[ "${1:-}" == "--once" ]]; then
  once=1
fi

autogit_log "daemon" "autogit daemon started"
while true; do
  autogit_log "daemon" "heartbeat"
  if [[ "$once" == "1" ]]; then
    break
  fi
  sleep 60
done
